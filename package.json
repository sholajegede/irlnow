{
  "name": "irlnow",
  "private": true,
  "type": "module",
  "description": "IRL NOW \u2014 social discovery for getting people outside.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*",
    "convex"
  ],
  "scripts": {
    "dev:web": "bun --filter @irlnow/web dev",
    "dev:mobile": "bun --filter @irlnow/mobile start",
    "build:web": "bun --filter @irlnow/web build",
    "typecheck": "bun run --filter '*' typecheck && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run && bun run --filter '@irlnow/*' test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "convex:dev": "convex dev",
    "convex:seed": "convex run seed:seedDevelopmentData"
  },
  "overrides": {
    "rolldown": "1.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  },
  "dependencies": {
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@vitest/coverage-v8": "^4.1.11",
    "convex-test": "^0.0.56",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.11"
  }
}
