{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      "@irlnow/domain": ["../../packages/domain/src/index.ts"],
      "@irlnow/backend/api": ["../../convex/_generated/api.d.ts"],
      "@irlnow/backend/*": ["../../convex/*"],
      "@irlnow/backend/dataModel": ["../../convex/_generated/dataModel.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    "*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
