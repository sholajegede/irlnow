# Copy to apps/mobile/.env and fill in.
#
# EXPO_PUBLIC_* values are embedded in the app binary and can be read out of
# it. Client identifiers and public URLs only — never a secret.

# Convex deployment. `bunx convex dev` prints this.
# A simulator can reach 127.0.0.1; a physical device needs your machine's LAN
# IP, or a cloud deployment.
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Public web origin — share links and QR destinations.
EXPO_PUBLIC_APP_ORIGIN=http://localhost:8080

# Kinde. Leave blank until a tenant exists; the app runs without it and
# anonymous discovery still works.
EXPO_PUBLIC_KINDE_DOMAIN=
EXPO_PUBLIC_KINDE_CLIENT_ID=
